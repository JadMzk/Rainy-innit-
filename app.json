{
  "expo": {
    "name": "Rainy innit",
    "slug": "rainy-innit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rainyinnit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.rainyinnit.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rainy innit uses your location to say whether you need a brolly."
      }
    },
    "android": {
      "package": "uk.rainyinnit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rainy innit uses your location to say whether you need a brolly."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D71920"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "weatherProvider": "open-meteo"
    }
  }
}
